+#ifdef _WIN32
+    void SystemPath_FileURL::getSystemPathFromFileURL_long()
+    {
+        const OUString roots[] = { u"C:\\"_ustr, u"\\\\localhost\\dsh-missing-share\\"_ustr };
+        const OUString suffix = u"\\program\\..\\.\\share\\\\file.ui"_ustr;
+        for (const auto& root : roots)
+        {
+            for (sal_Int32 length : { 249, 260, 300 })
+            {
+                std::u16string padding(length - root.getLength() - suffix.getLength(), u'a');
+                padding[100] = '\\';
+                const OUString middle(padding.data(), padding.size());
+                const OUString path = root + middle + suffix;
+                const OUString url = u"file:///"_ustr + path.replace('\\', '/');
+                OUString result;
+                CPPUNIT_ASSERT_EQUAL(osl::FileBase::E_None,
+                    osl::FileBase::getSystemPathFromFileURL(url, result));
+                OUString expected = root + middle + "\\share\\file.ui";
+                if (expected.getLength() > MAX_PATH - 12)
+                    expected = root.startsWith("\\\\")
+                        ? u"\\\\?\\UNC\\"_ustr + expected.copy(2)
+                        : u"\\\\?\\"_ustr + expected;
+                CPPUNIT_ASSERT(expected.equalsIgnoreAsciiCase(result));
+            }
+        }
+    }
+#endif
 
