diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -13310,6 +13310,28 @@
 HAVE_LO_CLANG_DLLEXPORTINLINES=
 
 if test \( "$ENABLE_SKIA" = TRUE -o "$ENABLE_PDFIUM" = TRUE \) -a "$COM_IS_CLANG" != TRUE; then
+    lo_skia_CFLAGS=$CFLAGS
+    lo_skia_CXXFLAGS=$CXXFLAGS
+    if test "$_os" = "WINNT"; then
+        lo_clang_flags()
+        {
+            lo_other_flags=
+            lo_path_flags=
+            for lo_flag in "[$]@"; do
+                case "$lo_flag" in
+                    /experimental:deterministic) ;;
+                    /pathmap:*)
+                        lo_map=${lo_flag#/pathmap:}
+                        lo_path_flags="/clang:-ffile-prefix-map=$lo_map /clang:-fdebug-prefix-map=$lo_map $lo_path_flags"
+                        ;;
+                    *) lo_other_flags="$lo_other_flags $lo_flag" ;;
+                esac
+            done
+            printf '%s\n' "$lo_other_flags $lo_path_flags"
+        }
+        CFLAGS=$(lo_clang_flags $CFLAGS)
+        CXXFLAGS=$(lo_clang_flags $CXXFLAGS)
+    fi
     if test -n "$LO_CLANG_CC" -a -n "$LO_CLANG_CXX"; then
         AC_MSG_CHECKING([for Clang])
         AC_MSG_RESULT([$LO_CLANG_CC / $LO_CLANG_CXX])
@@ -13593,6 +13615,8 @@
 
         CXX="$save_CXX"
     fi
+    CFLAGS=$lo_skia_CFLAGS
+    CXXFLAGS=$lo_skia_CXXFLAGS
 fi
 #
 # prefix LO_CLANG_CC/LO_CLANG_CXX with ccache if needed
diff --git a/solenv/gbuild/platform/com_MSC_class.mk b/solenv/gbuild/platform/com_MSC_class.mk
--- a/solenv/gbuild/platform/com_MSC_class.mk
+++ b/solenv/gbuild/platform/com_MSC_class.mk
@@ -57,7 +57,10 @@
 # When gb_LinkTarget_use_clang is used, filter out MSVC flags that Clang doesn't know.
 # $(call gb_CObject__filter_out_clang_cflags,cflags)
 define gb_CObject__filter_out_clang_cflags
-    $(filter-out $(gb_FilterOutClangCFLAGS),$(1))
+    $(filter-out /experimental:deterministic /pathmap:% $(gb_FilterOutClangCFLAGS),$(1)) \
+    $(foreach prefix,$(sort $(foreach mapping,$(filter /pathmap:%,$(1)),$(word 1,$(subst =, ,$(mapping))))), \
+        $(patsubst /pathmap:%,/clang:-ffile-prefix-map=%,$(filter $(prefix)=%,$(1))) \
+        $(patsubst /pathmap:%,/clang:-fdebug-prefix-map=%,$(filter $(prefix)=%,$(1))))
 endef
 
 # $(call gb_CObject__command_pattern,object,flags,source,dep-file,compiler-plugins,compiler)
