+#ifdef DISABLE_DYNLOADING
+// Static SAL has no DLL entry point. Preserve per-thread cleanup through the
+// executable's TLS directory, including threads created outside osl_createThread.
+static void NTAPI salStaticThreadCallback(PVOID, DWORD reason, PVOID)
+{
+    if (reason == DLL_THREAD_DETACH)
+        osl_callThreadKeyCallbackOnThreadDetach();
+}
+#pragma section(".CRT$XLB", long, read)
+extern "C" __declspec(allocate(".CRT$XLB")) PIMAGE_TLS_CALLBACK const sal_static_thread_callback
+    = salStaticThreadCallback;
+#pragma comment(linker, "/include:_tls_used")
+#pragma comment(linker, "/include:sal_static_thread_callback")
