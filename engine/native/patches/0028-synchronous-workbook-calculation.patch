+// Calculation through the model does not require an interactive dispatcher or event loop.
+static int doc_calculateAll(LibreOfficeKitDocument* pThis)
+{
+    SolarMutexGuard aGuard;
+    SetLastExceptionMsg();
+    try
+    {
+        auto* pDocument = static_cast<LibLODocument_Impl*>(pThis);
+        uno::Reference<sheet::XCalculatable> xCalculatable(pDocument->mxComponent, uno::UNO_QUERY_THROW);
+        xCalculatable->calculateAll();
+        return 1;
+    }
+    catch (const uno::Exception& exception)
+    {
+        SetLastExceptionMsg("exception: " + exception.Message);
+    }
+    return 0;
+}
