+        $(foreach object,$(GENNASMOBJECTS),$(call gb_GenNasmObject_get_target,$(object))) \
+        $(foreach extraobjectlist,$(EXTRAOBJECTLISTS),$(shell cat $(extraobjectlist)))) && \
+    $(gb_LINK) -lib -nologo -out:$(1) @$${RESPONSEFILE}; RC=$$?; rm -f $${RESPONSEFILE}; \
