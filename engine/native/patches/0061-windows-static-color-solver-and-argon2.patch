--- /dev/null
+++ b/external/dsh-static-msvc.props
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <!-- Static bundled libraries share Core's dynamic CRT and section pruning. -->
+  <!-- MSVC IL cannot be consumed by LLVM lld-link. -->
+  <PropertyGroup>
+    <WholeProgramOptimization>false</WholeProgramOptimization>
+  </PropertyGroup>
+  <ItemDefinitionGroup>
+    <ClCompile>
+      <WholeProgramOptimization>false</WholeProgramOptimization>
+      <RuntimeLibrary>$(DSHStaticRuntime)</RuntimeLibrary>
+      <PreprocessorDefinitions>$(DSHStaticDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
+      <FunctionLevelLinking>true</FunctionLevelLinking>
+      <AdditionalOptions>/GL- /Gw %(AdditionalOptions)</AdditionalOptions>
+    </ClCompile>
+  </ItemDefinitionGroup>
+</Project>
