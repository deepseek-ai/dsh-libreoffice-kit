Core builds dbtools even when database connectivity and its drivers are disabled.
Writer and form controls still use its parser, column formatting and data-source
helpers. Keep their shared utility dependency independent of driver selection.

diff --git a/forms/Library_frm.mk b/forms/Library_frm.mk
index 7b850fce1..d0726de5b 100644
--- a/forms/Library_frm.mk
+++ b/forms/Library_frm.mk
@@ -28,7 +28,7 @@ $(eval $(call gb_Library_use_libraries,frm,\
     comphelper \
     cppu \
     cppuhelper \
-    $(call gb_Helper_optional,DBCONNECTIVITY,dbtools) \
+    dbtools \
     editeng \
     i18nlangtag \
     sal \
