 void SystemFontList::AnnounceFonts( vcl::font::PhysicalFontCollection& rFontCollection ) const
 {
-    for(const auto& rEntry : maFontContainer )
-    {
-        rFontCollection.Add( rEntry.second.get() );
-    }
+    // Font ids are descriptor addresses. Their hash-table order changes between
+    // processes, but PhysicalFontCollection uses the first face of a family for
+    // aliases and keeps the first equal-quality duplicate. Use font identity,
+    // not allocation order, to make those choices repeatable.
+    std::vector<std::tuple<OUString, OUString, CoreTextFontFace*>> aFonts;
+    aFonts.reserve(maFontContainer.size());
+    for (const auto& rEntry : maFontContainer)
+    {
+        auto* pFace = rEntry.second.get();
+        auto pDescriptor = pFace->GetFontDescriptorRef();
+        auto pName = static_cast<CFStringRef>(
+            CTFontDescriptorCopyAttribute(pDescriptor, kCTFontNameAttribute));
+        auto pUrl = static_cast<CFURLRef>(
+            CTFontDescriptorCopyAttribute(pDescriptor, kCTFontURLAttribute));
+        aFonts.emplace_back(GetOUString(pName),
+                            pUrl ? GetOUString(CFURLGetString(pUrl)) : OUString(), pFace);
+        if (pName)
+            CFRelease(pName);
+        if (pUrl)
+            CFRelease(pUrl);
+    }
+    std::sort(aFonts.begin(), aFonts.end(), [](const auto& rLeft, const auto& rRight) {
+        return std::tie(std::get<0>(rLeft), std::get<1>(rLeft))
+             < std::tie(std::get<0>(rRight), std::get<1>(rRight));
+    });
+    for (const auto& rFont : aFonts)
+        rFontCollection.Add(std::get<2>(rFont));
 }
 
