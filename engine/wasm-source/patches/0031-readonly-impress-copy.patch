@@ -88,6 +88,8 @@
 #include <vcl/ptrstyle.hxx>
 #include <vcl/themecolors.hxx>
 #include <vcl/svapp.hxx>
+#include <vcl/unohelp2.hxx>
+#include <svx/svditer.hxx>
 #include <Outliner.hxx>
 #include <LibreOfficeKit/LibreOfficeKitEnums.h>
 
@@ -4434,7 +4436,36 @@ uno::Reference<datatransfer::XTransferable> SdXImpressDocument::getSelection()
     if (!pViewShell)
         return uno::Reference<datatransfer::XTransferable>();
 
-    return pViewShell->GetSelectionTransferable();
+    auto xSelection = pViewShell->GetSelectionTransferable();
+    if (xSelection.is() || !pViewShell->GetViewShell()->IsLokReadOnlyView())
+        return xSelection;
+
+    // A read-only view cannot enter text edit to create a substring selection.
+    // Copy the selected objects' existing text without creating an EditView,
+    // changing the selection, or opening any editing command path.
+    SdrView* pView = pViewShell->GetView();
+    if (!pView)
+        return {};
+    OUStringBuffer aText;
+    SdrObjListIter aObjects(pView->GetMarkedObjectList(), SdrIterMode::DeepNoGroups);
+    while (aObjects.IsMore())
+    {
+        const SdrObject* pObject = aObjects.Next();
+        if (pObject->IsEmptyPresObj())
+            continue;
+        const OutlinerParaObject* pParagraphs = pObject->GetOutlinerParaObject();
+        if (!pParagraphs)
+            continue;
+        const OUString aObjectText = pParagraphs->GetTextObject().GetText();
+        if (aObjectText.isEmpty())
+            continue;
+        if (!aText.isEmpty())
+            aText.append('\n');
+        aText.append(aObjectText);
+    }
+    if (aText.isEmpty())
+        return {};
+    return new vcl::unohelper::TextDataObject(aText.makeStringAndClear());
 }
 
