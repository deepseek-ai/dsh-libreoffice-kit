+// Private Kit entry point; the public LibreOfficeKit function table is unchanged.
+extern "C" char* dsh_lok_configure_view_core(LibreOfficeKitDocument* pThis, int nReadOnly,
+                                            int nLayout, int nWidth,
+                                            int nAnchorX, int nAnchorY)
+{
+    SolarMutexGuard aGuard;
+    SetLastExceptionMsg();
+    ITiledRenderable* pDoc = getTiledRenderable(pThis);
+    const int nView = doc_getView(pThis);
+    if (!pDoc || nView < 0 || nReadOnly != 1 || (nLayout != 0 && nLayout != 1)
+        || (nLayout == 1 && (nWidth <= 0 || getDocumentType(pThis) != LOK_DOCTYPE_TEXT)))
+    {
+        SetLastExceptionMsg(u"Invalid read-only document layout"_ustr);
+        return nullptr;
+    }
+
+    SfxLokHelper::setViewReadOnly(nView, true);
+    const Point aAnchor(nAnchorX, nAnchorY);
+    tools::Rectangle aResult;
+    const bool bChanged = getDocumentType(pThis) == LOK_DOCTYPE_TEXT
+        && pDoc->setReadingLayout(nLayout == 1, nWidth,
+                                 nAnchorX >= 0 && nAnchorY >= 0 ? &aAnchor : nullptr, &aResult);
+    const Size aSize = pDoc->getDocumentSize();
+    tools::JsonWriter aJson;
+    aJson.put("changed", bChanged);
+    aJson.put("width", aSize.Width());
+    aJson.put("height", aSize.Height());
+    if (!aResult.IsEmpty())
+    {
+        auto aNode = aJson.startNode("anchor");
+        aJson.put("x", aResult.Left());
+        aJson.put("y", aResult.Top());
+        aJson.put("width", aResult.GetWidth());
+        aJson.put("height", aResult.GetHeight());
+    }
+    return convertOString(aJson.finishAndGetAsOString());
+}
