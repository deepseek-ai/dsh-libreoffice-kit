+bool SwXTextDocument::setReadingLayout(bool bContinuous, tools::Long nWidth,
+                                     const Point* pAnchor, tools::Rectangle* pResult)
+{
+    SolarMutexGuard aGuard;
+    SwWrtShell* pShell = m_pDocShell ? m_pDocShell->GetWrtShell() : nullptr;
+    if (!pShell || !pShell->GetLayout())
+        throw uno::RuntimeException(u"Writer reading view is unavailable"_ustr);
+    if (bContinuous && (nWidth <= 0 || !pShell->GetSfxViewShell()->IsLokReadOnlyView()))
+        throw uno::RuntimeException(u"Continuous layout requires a read-only view and positive width"_ustr);
+
+    if (pResult)
+        *pResult = tools::Rectangle();
+    // The API width includes Writer's document border. The layout column
+    // itself excludes that border so plain text fits the available viewport.
+    const tools::Long nReadingWidth
+        = bContinuous ? std::max<tools::Long>(1, nWidth - 2 * DOCUMENTBORDER) : 0;
+    const SwViewOption& rOldOptions = *pShell->GetViewOptions();
+    if (rOldOptions.getBrowseMode() == bContinuous && !rOldOptions.getDraftView()
+        && pShell->getLOKReadingWidth() == nReadingWidth)
+        return false;
+
+    // Keep a model position, never the user's selection. The old pixel offset
+    // alone cannot survive wrapping text into a different reading-column width.
+    std::optional<SwPosition> aAnchor;
+    if (pAnchor)
+    {
+        SwPosition aPosition(GetDocOrThrow().GetNodes());
+        Point aPoint(*pAnchor);
+        SwCursorMoveState aMove;
+        aMove.m_bSetInReadOnly = true;
+        if (pShell->GetLayout()->GetModelPositionForViewPoint(&aPosition, aPoint, &aMove)
+            && aPosition.GetNode().IsTextNode())
+            aAnchor.emplace(aPosition);
+    }
+
+    {
+        pShell->StartAction();
+        comphelper::ScopeGuard aEndAction([pShell] { pShell->EndAction(); });
+        pShell->setLOKReadingWidth(nReadingWidth);
+        pShell->GetLayout()->InvalidateBrowseWidth();
+        SwViewOption aOptions(rOldOptions);
+        aOptions.setBrowseMode(bContinuous);
+        aOptions.setDraftView(false);
+        aOptions.SetHideWhitespaceMode(false);
+        aOptions.SetViewLayoutColumns(1);
+        aOptions.SetViewLayoutBookMode(false);
+        // Fixed document metrics keep changing tile raster scales from
+        // changing the text layout underneath a read-only capture.
+        aOptions.SetPrtFormat(true);
+        pShell->ApplyViewOptions(aOptions);
+        pShell->InvalidateLayout(true);
+        pShell->CalcLayout();
+        pShell->GetWin()->EnableMapMode(false);
+    }
+
+    if (aAnchor && pResult)
+    {
+        if (SwTextNode* pNode = aAnchor->GetNode().GetTextNode())
+        {
+            if (const SwContentFrame* pFrame = pNode->getLayoutFrame(pShell->GetLayout(), &*aAnchor))
+            {
+                SwRect aRectangle;
+                if (pFrame->GetCharRect(aRectangle, *aAnchor))
+                    *pResult = aRectangle.SVRect();
+            }
+        }
+    }
+    const Size aSize = getDocumentSize();
+    const OString aPayload = OString::number(aSize.Width()) + ", " + OString::number(aSize.Height());
+    SfxLokHelper::notifyDocumentSizeChanged(pShell->GetSfxViewShell(), aPayload, this);
+    return true;
+}
