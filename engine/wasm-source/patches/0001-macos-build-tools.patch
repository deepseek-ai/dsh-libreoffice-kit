--- a/configure.ac
+++ b/configure.ac
@@ -3870,8 +3870,13 @@ if test $_os = Darwin; then
     if test ! -d "$MACOSX_SDK_PATH"; then
         AC_MSG_ERROR([Could not find an appropriate macOS SDK])
     fi
