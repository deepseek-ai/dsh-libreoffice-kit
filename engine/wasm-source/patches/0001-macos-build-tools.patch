+        my_xcode_ver1=$(xcrun xcodebuild -version | tail -n 1)
+        MACOSX_XCODE_BUILD_VERSION=${my_xcode_ver1#Build version }
+    fi
 
     LIBTOOL=/usr/bin/libtool
     INSTALL_NAME_TOOL=install_name_tool
