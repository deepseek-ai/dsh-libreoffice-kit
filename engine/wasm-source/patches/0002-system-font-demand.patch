+bool PhysicalFontCollection::EnsureSystemFonts(const FontSelectPattern& rPattern,
+                                                const OUString& rMissingCodes) const
+{
+    const OUString aLanguage = LanguageTag(rPattern.meLanguage).getBcp47();
+    char aError[4096] = {};
+    int nFatal = 0;
+    // The resolver runs on the runtime's JS thread, including when layout runs in a pthread.
+    // It may read host files and write MEMFS, but must not reenter LibreOffice.
+    auto* pPaths = static_cast<char*>(MAIN_THREAD_EM_ASM_PTR({
+        try {
+            const resolver = Module['dshResolveSystemFonts'];
+            if (typeof resolver !== 'function')
+                throw new Error('LibreOffice system font resolver is not configured');
+            const paths = resolver({
+                family: UTF16ToString($0),
+                style: UTF16ToString($1),
+                weight: $2,
+                italic: $3,
+                width: $4,
+                pitch: $5,
+                language: UTF16ToString($6),
+                codePoints: Array.from(UTF16ToString($7), char => char.codePointAt(0))
+            });
+            if (!Array.isArray(paths) || paths.some(path =>
+                typeof path !== 'string' || !path.startsWith('/') || [0, 10, 13].some(code =>
+                    path.includes(String.fromCharCode(code)))))
+                throw new TypeError('LibreOffice system font resolver must return MEMFS paths synchronously');
+            if (paths.length === 0)
+                return 0;
+            const bytes = new TextEncoder().encode(paths.join(String.fromCharCode(10)) + String.fromCharCode(0));
+            const pointer = Module['_malloc'](bytes.length);
+            if (!pointer)
+                throw new Error('LibreOffice system font response allocation failed');
+            HEAPU8.set(bytes, pointer);
+            return pointer;
+        } catch (error) {
+            if (error instanceof WebAssembly.RuntimeError) {
+                if (typeof Module['onAbort'] === 'function')
+                    Module['onAbort'](error);
+                HEAP32[$10 >> 2] = 1;
+                return 0;
+            }
+            stringToUTF8('LibreOffice system font callback failed: ' + String(error), $8, $9);
+            return 0;
+        }
+    }, rPattern.GetFamilyName().getStr(), rPattern.GetStyleName().getStr(),
+       static_cast<int>(rPattern.GetWeight()), static_cast<int>(rPattern.GetItalic()),
+       static_cast<int>(rPattern.GetWidthType()), static_cast<int>(rPattern.GetPitch()),
+       aLanguage.getStr(), rMissingCodes.getStr(), aError, sizeof(aError), &nFatal));
+    // WASM traps bypass C++ unwinding; an aborted engine cannot safely allocate an exception.
+    if (nFatal)
+        __builtin_trap();
+    // EM_ASM imports are nothrow; construct the C++ exception only after returning from JS.
+    if (aError[0] != '\0')
+        throw std::runtime_error(aError);
+    std::unique_ptr<char, decltype(&std::free)> aOwnedPaths(pPaths, std::free);
+    if (!pPaths)
+        return false;
+
+    bool bAdded = false;
+    const OUString aPaths = OUString::fromUtf8(pPaths);
+    sal_Int32 nPosition = 0;
+    do
+    {
+        const OUString aPath = aPaths.getToken(0, '\n', nPosition);
+        if (maDemandFontFiles.find(aPath) != maDemandFontFiles.end())
+            continue;
+        OUString aFileURL;
+        if (osl::FileBase::getFileURLFromSystemPath(aPath, aFileURL) != osl::FileBase::E_None
+            || !FreeTypeTextRenderImpl::RegisterFontFile(
+                const_cast<PhysicalFontCollection*>(this), aFileURL, OUString()))
+            throw std::runtime_error("LibreOffice could not register a supplied system font");
+        maDemandFontFiles.insert(aPath);
+        bAdded = true;
+    } while (nPosition >= 0);
+
+    if (bAdded)
+    {
+        // Active layout objects keep their font faces; only derived matching data becomes stale.
+        mbMatchData = false;
+        mpFallbackList.reset();
+        mnFallbackCount = -1;
+    }
+    return bAdded;
+}
