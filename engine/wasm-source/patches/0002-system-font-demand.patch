+    if (aError[0] != '\0')
+        throw std::runtime_error(aError);
+    std::unique_ptr<char, decltype(&std::free)> aOwnedPaths(pPaths, std::free);
+    if (!pPaths)
+        return {};
+
+    std::vector<OUString> aFamilies;
+    const OUString aPaths = OUString::fromUtf8(pPaths);
+    sal_Int32 nPosition = 0;
+    do
+    {
+        const OUString aRecord = aPaths.getToken(0, '\n', nPosition);
+        const sal_Int32 nSeparator = aRecord.indexOf('\t');
+        if (nSeparator < 0)
+            throw std::runtime_error("LibreOffice received an invalid font face record");
+        const OUString aPath = aRecord.copy(0, nSeparator);
+        const OUString aFamily = aRecord.copy(nSeparator + 1);
+        if (!aFamily.isEmpty())
+        {
+            aFamilies.push_back(aFamily);
+            maDemandFontFamilies.insert(GetEnglishSearchFontName(aFamily));
+        }
+        if (maDemandFontFiles.find(aPath) != maDemandFontFiles.end())
+            continue;
+        OUString aFileURL;
+        if (osl::FileBase::getFileURLFromSystemPath(aPath, aFileURL) != osl::FileBase::E_None
+            || !FreeTypeTextRenderImpl::RegisterFontFile(
+                const_cast<PhysicalFontCollection*>(this), aFileURL, aFamily))
+            throw std::runtime_error("LibreOffice could not register a supplied system font");
+        maDemandFontFiles.insert(aPath);
+        rAdded = true;
+    } while (nPosition >= 0);
+
+    if (rAdded)
+    {
+        // Active layout objects keep their font faces; only derived matching data becomes stale.
+        mbMatchData = false;
+        mpFallbackList.reset();
+        mnFallbackCount = -1;
+    }
+    return aFamilies;
+}
