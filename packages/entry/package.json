{
  "name": "@deepseek-ai/libreoffice-kit",
  "description": "WASM Office previews, document images, and conversion for Node and browsers",
  "version": "0.0.2-rc6",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness/libreoffice-kit.git",
    "directory": "packages/entry"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./fonts": {
      "types": "./lib/types/font-source.d.ts",
      "default": "./lib/font-source.js"
    },
    "./font-config": {
      "types": "./lib/types/font-config.d.ts",
      "default": "./lib/font-config.js"
    },
    "./document-inspection": {
      "types": "./lib/types/document.d.ts",
      "default": "./lib/document.js"
    },
    "./cli": "./lib/cli.js",
    "./browser-assets": {
      "types": "./lib/types/browser-assets.d.ts",
      "default": "./lib/browser-assets.js"
    },
    "./internal/rendering": {
      "types": "./lib/types/rendering.d.ts",
      "default": "./lib/rendering.js"
    },
    "./internal/engine-rendering": {
      "types": "./lib/types/engine-rendering.d.ts",
      "default": "./lib/engine-rendering.js"
    },
    "./internal/sheet-geometry": {
      "types": "./lib/types/sheet-geometry.d.ts",
      "default": "./lib/sheet-geometry.js"
    },
    "./browser": {
      "types": "./lib/browser/types/index.d.ts",
      "import": "./lib/browser/index.js"
    }
  },
  "files": [
    "README.zh.md",
    "lib/index.js",
    "lib/cli.js",
    "lib/worker.js",
    "NOTICE",
    "lib/types/**/*.d.ts",
    "lib/font-source.js",
    "lib/font-worker.js",
    "lib/font-config.js",
    "lib/document.js",
    "assets/font-subset.wasm",
    "assets/font-subset.json",
    "sources/font-subset/",
    "licenses/font-subset/",
    "lib/browser-assets.js",
    "lib/rendering.js",
    "lib/engine-rendering.js",
    "lib/sheet-geometry.js",
    "lib/browser/",
    "sources/browser/",
    "licenses/javascript/"
  ],
  "dependencies": {
    "@unicode/unicode-17.0.0": "2.0.7",
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "saxes": "6.0.0",
    "@deepseek-ai/libreoffice-kit-wasm": "workspace:*"
  },
  "bin": {
    "libreoffice-kit": "./lib/cli.js"
  }
}
