{
  "name": "@deepseek-ai/libreoffice-kit",
  "description": "Convert and recalculate Office documents with prebuilt LibreOffice",
  "version": "0.0.2-rc4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness/libreoffice-kit.git",
    "directory": "packages/entry"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cli": "./lib/cli.js"
  },
  "files": [
    "README.zh.md",
    "lib/index.js",
    "lib/cli.js",
    "lib/worker.js",
    "NOTICE",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "saxes": "6.0.0",
    "@deepseek-ai/libreoffice-kit-wasm": "workspace:*"
  },
  "bin": {
    "libreoffice-kit": "./lib/cli.js"
  }
}
